# ─────────────────────────────────────────────────────────────────────────────
# Agentic HRMS — environment template
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit it.
# Settings are read ONLY by backend/core/config.py (the single env reader).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (REQUIRED — no default; app will not boot without it) ────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost/agentic_hrms

# ── Security / JWT (REQUIRED — no default) ────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRY_HOURS=24

# ── CORS (JSON array OR comma-separated, both accepted) ───────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Email / SMTP ──────────────────────────────────────────────────────────────
EMAIL_USER=
EMAIL_PASS=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
HR_EMAIL=
ADMIN_EMAIL=

# ── OpenAI ────────────────────────────────────────────────────────────────────
AI_KEY=
AI_MODEL=gpt-4o-mini

# ── Twilio (SMS; optional unless PIN-over-SMS is used) ────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Misc ──────────────────────────────────────────────────────────────────────
DEBUG=true
ALLOW_SEED=false

BEHAVIOR_ANALYTICS_ENABLED=true
BEHAVIOR_WINDOW_DAYS=7
BEHAVIOR_THRESHOLD_SENSITIVE=3
BEHAVIOR_THRESHOLD_LEAVE_INTENT=5
BEHAVIOR_THRESHOLD_EXIT_INTENT=2
BEHAVIOR_THRESHOLD_GROWTH=4
BEHAVIOR_THRESHOLD_POSH=2
NUDGE_REPEAT_COOLDOWN_DAYS=14
DOCUMENT_VIEWER_ENABLED=true
BEHAVIOR_VIEW_COOLDOWN_MINUTES=5